{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm -r run build",
  "outputDirectory": "preview",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!css|js|assets|favicon.ico|_redirects|_headers).*)",
      "destination": "/index.html"
    }
  ]
}
