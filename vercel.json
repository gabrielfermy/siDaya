{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'No install needed for static site'",
  "buildCommand": "echo 'Static portal ready'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!css|js|favicon.ico|_redirects|_headers).*)",
      "destination": "/index.html"
    }
  ]
}
