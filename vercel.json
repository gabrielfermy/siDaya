{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm -r run build && esbuild api/_entry.ts --bundle --platform=node --target=node20 --format=cjs --outfile=api/index.js",
  "outputDirectory": "preview",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!css|js|assets|favicon.ico|_redirects|_headers).*)",
      "destination": "/index.html"
    }
  ]
}
