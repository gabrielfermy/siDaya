{
  "name": "@sidaya/api-core",
  "version": "0.1.0",
  "description": "Core backend service layer, multi-tenancy middleware, and domain logic for SiDaya",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:email": "tsx scripts/test-email.ts"
  },
  "dependencies": {
    "@sidaya/database": "workspace:*",
    "@sidaya/payment-core": "workspace:*",
    "@sidaya/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
