{
  "name": "@sidaya/shared-types",
  "version": "0.1.0",
  "description": "Shared TypeScript DTOs, Enums, and Zod Schemas for SiDaya Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
